+pub(crate) static CUBESAT_MODE: std::sync::atomic::AtomicU8 = std::sync::atomic::AtomicU8::new(255);
+
+/// 0 = Earth (specific), 1 = Universe (big picture).
+#[cfg(target_arch = "wasm32")]
+#[wasm_bindgen]
+pub fn set_cubesat_mode(mode: u32) {
+    CUBESAT_MODE.store(mode.min(1) as u8, std::sync::atomic::Ordering::Relaxed);
+}
+
+#[cfg(target_arch = "wasm32")]
+pub(crate) fn take_cubesat_mode() -> Option<u8> {
+    let value = CUBESAT_MODE.swap(255, std::sync::atomic::Ordering::Relaxed);
+    if value == 255 { None } else { Some(value) }
+}
+
+#[cfg(target_arch = "wasm32")]
+pub(crate) fn cubesat_state() -> Option<[f64; 6]> {
+    CUBESAT_STATE.lock().ok().and_then(|state| *state)
+}
