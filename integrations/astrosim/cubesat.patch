+pub fn set_cubesat_state(x: f64, y: f64, z: f64, vx: f64, vy: f64, vz: f64) {
+    if let Ok(mut state) = CUBESAT_STATE.lock() {
+        *state = Some([x, y, z, vx, vy, vz]);
+    }
